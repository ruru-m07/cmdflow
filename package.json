{
  "name": "cmdflow",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check-types": "turbo run check-types",
    "tegami": "bun scripts/tegami.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "tegami": "1.4.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
