{
  "name": "@cmdflow/solid",
  "version": "0.0.0",
  "description": "Headless Solid primitives over the shared CmdFlow engine and DOM controller.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "test": "bun test --conditions=browser ./test/adapter.test.ts && bun test ./test-server/ssr.test.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruru-m07/cmdflow.git",
    "directory": "packages/solid"
  },
  "dependencies": {
    "@cmdflow/core": "workspace:*",
    "@cmdflow/dom": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "1.9.15",
    "typescript": "7.0.2"
  }
}
